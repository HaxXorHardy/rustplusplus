{
    "name": "rustplusplus",
    "version": "1.53.3",
    "description": "A NodeJS Discord Bot that uses the rustplus.js library to utilize the power of the Rust+ Companion App with additional Quality-of-Life features.",
    "main": "index.js",
    "scripts": {
        "start": "node .",
        "rustplus:login": "node scripts/rustplusLogin.js",
        "build:static-db": "node scripts/buildStaticFilesDb.js",
        "download:rust-items": "node scripts/downloadRustItems.js",
        "update:static-data": "node scripts/updateStaticData.js",
        "test": "tsc --noEmit -p . && tsc -p tsconfig.checkjs.json && node --test \"test/**/*.test.js\""
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/HaxXorHardy/rustplusplus.git"
    },
    "author": "HaxXorHardy (https://github.com/HaxXorHardy) - fork of FaiThiX (https://github.com/faithix), originally by Alexander Emanuelsson (alexemanuelol, https://github.com/alexemanuelol)",
    "license": "SEE LICENSE IN LICENSE",
    "bugs": {
        "url": "https://github.com/HaxXorHardy/rustplusplus/issues"
    },
    "homepage": "https://github.com/HaxXorHardy/rustplusplus#readme",
    "dependencies": {
        "@discordjs/rest": "^2.5.1",
        "@discordjs/voice": "^0.18.0",
        "@formatjs/intl": "^2.6.9",
        "@liamcottle/push-receiver": "file:stubs/push-receiver",
        "@liamcottle/rustplus.js": "git+https://github.com/alexemanuelol/rustplus.js.git#089cfd3db1b04709911948bce669273139c6a124",
        "axios": "^1.3.4",
        "colors": "^1.4.0",
        "discord-api-types": "^0.38.14",
        "discord.js": "^14.21.0",
        "dotenv": "^18.0.7",
        "gm": "^1.25.0",
        "jimp": "^1.6.1",
        "protobufjs": "^7.6.3",
        "qrcode": "^1.5.4",
        "steam-session": "^1.9.4",
        "translate": "^3.1.1",
        "winston": "^3.8.2"
    },
    "devDependencies": {
        "playwright-core": "^1.58.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "overrides": {
        "@protobufjs/utf8": "^1.1.2",
        "ws": "^8.21.0",
        "qs": "^6.16.1",
        "express": {
            "path-to-regexp": "0.1.13"
        },
        "jimp": "$jimp",
        "zod": "^4.6.7",
        "@liamcottle/push-receiver": "$@liamcottle/push-receiver"
    }
}
