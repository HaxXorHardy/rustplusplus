# ---------------------------------------------------------------------------
#  rustplusplus - example environment configuration
#  Fork: https://github.com/HaxXorHardy/rustplusplus
#
#  Copy this file to ".env" and fill in your own values.
#  (".env" is git-ignored and loaded automatically on startup.)
# ---------------------------------------------------------------------------

# --- Discord Bot -----------------------------------------------------------
# Discord Application "General Information" -> Application ID
RPP_DISCORD_CLIENT_ID=
# Discord Application "Bot" -> Token
RPP_DISCORD_TOKEN=
# Display name of the bot (fallback only)
RPP_DISCORD_USERNAME=rustplusplus
# If true, only admins can delete servers/switches, manage credentials and reset channels
RPP_NEED_ADMIN_PRIVILEGES=true

# --- Battlemetrics ---------------------------------------------------------
# Optional Battlemetrics API token. Leave empty to disable the Battlemetrics tracker.
RPP_BATTLEMETRICS_TOKEN=

# --- General ---------------------------------------------------------------
# Language used for bot messages (see src/languages)
RPP_LANGUAGE=en
# Rust+ polling interval in milliseconds
RPP_POLLING_INTERVAL=10000
# Reconnect interval in milliseconds
RPP_RECONNECT_INTERVAL=15000
# How the Rust+ websocket is reached: auto (the authenticated socket first, then the removed direct/proxy ones)
RPP_RUSTPLUS_TRANSPORT=auto
# Build timestamp of the Rust+ web app that the socket handshake sends (?v=...). Empty = built-in value.
RPP_RUSTPLUS_BUILD_VERSION=
# Renew the Rust+ account token this many seconds before it expires. The renewal uses the Steam refresh token of the
# last login, so no password and no Steam Guard is needed. Default: 259200 (3 days)
RPP_RUSTPLUS_TOKEN_RENEW_BEFORE=259200
# How often (ms) the notification history of the account is read, so servers and devices that were paired in-game are
# adopted automatically. Lower it (e.g. 15000) to see a pairing almost instantly. Default: 300000 (5 minutes)
RPP_RUSTPLUS_HISTORY_INTERVAL=300000
# Push notifications of the Rust+ app (raid alarms, team logins, pairings in real time). The bot registers itself as a
# device of the account. false = only the history above.
RPP_PUSH_ENABLED=true
# Report smart alarms of servers the bot is not connected to.
RPP_PUSH_ALARMS_OTHER_SERVERS=true
# How often (ms) the account state (/api/syncData) is read. The history is the source of truth for pairings and is read
# on every refresh, this slower snapshot is cached in between. Default: 300000 (5 minutes)
RPP_RUSTPLUS_SYNCDATA_INTERVAL=300000
# Map events (cargo ship, patrol helicopter, chinook, oil rigs, vending machines, deep sea, traveling vendor): the Rust+
# API stopped sending them (2026-11-18). The code stays but does not run unless this is true.
RPP_MAP_EVENTS_ENABLED=false
# The device images in Discord are linked from this repository on GitHub (no upload on every edit). Another copy:
# RPP_IMAGE_BASE_URL=https://raw.githubusercontent.com/<owner>/rustplusplus/master
# Defaults for the guild settings below. Each of them can be changed per Discord server in the settings channel; the
# value chosen there wins, these only apply while nothing was chosen.
# Smart alarm cooldown in seconds: an alarm that fires again within it posts no new message. 0 = every trigger.
RPP_ALARM_COOLDOWN=60
# Raid mode: an alarm while nobody of the team is online sends a direct message and a raid report afterwards.
RPP_RAID_MODE=true
# Warn this many hours before a tool cupboard with a storage monitor runs out of upkeep. 0 = off.
RPP_UPKEEP_WARNING_HOURS=6
# A storage monitor that pushes changes non-stop (tool cupboard) edits its Discord message at most once in this many
# seconds, the edit after the pause shows the latest state. Buttons still update at once. 0 = no pause.
RPP_STORAGE_MONITOR_EDIT_INTERVAL=30
# Time zone of switch group schedules without their own zone and of the weekly team report (e.g. Europe/Berlin).
RPP_TIMEZONE=UTC
# Optional: Steam login for "npm run rustplus:login" (see FAQ.md). The Discord command /credentials login does the
# same and needs no .env entry.
RPP_STEAM_ACCOUNT=
RPP_STEAM_PASSWORD=
# Optional: Steam Web API key (https://steamcommunity.com/dev/apikey). Currently unused by the bot: it feeds
# src/util/steamTimePlayed.js (Rust playtime as Steam reports it), kept for a later use. BattleMetrics needs no key.
RPP_STEAM_API_KEY=
# Interval (ms) for checking whether the stored Rust+ login token is about to expire. Default: 3600000 (1 hour)
RPP_CREDENTIALS_EXPIRY_CHECK_INTERVAL=3600000
# How long (seconds) before expiry the owner of the account is warned via DM. Only accounts without a Steam refresh
# token can reach this state, every other login is renewed by the bot itself. Default: 259200 (3 days)
RPP_CREDENTIALS_EXPIRY_WARNING=259200

# --- Debug -----------------------------------------------------------------
# Debug mode: enables verbose (debug level) logging. Set to true for troubleshooting.
RPP_DEBUG=false
# Include call stack traces in error logs (debug mode forces this on anyway)
RPP_LOG_CALL_STACK=false

# --- RustLabs scraper (scripts/process_rustlabs.js) ------------------------
# Delay in milliseconds between page requests (politeness / anti-bot). Default: 2000
RPP_RUSTLABS_SLEEP_MS=2000
# Run the browser without a visible window. Default: false
# Note: Cloudflare may block headless requests; solve the challenge once in visible mode first.
RPP_RUSTLABS_HEADLESS=false
# After a Cloudflare challenge is solved in visible mode, continue headless. Default: true
RPP_RUSTLABS_HEADLESS_AFTER_CHALLENGE=true
# Request timeout in milliseconds. Default: 30000
RPP_RUSTLABS_TIMEOUT_MS=30000
# Max time (ms) to wait for a manually solved Cloudflare challenge. Default: 180000
RPP_RUSTLABS_CHALLENGE_WAIT_MS=180000
# Explicit browser executable (Edge/Chrome). Leave empty to auto-detect.
RPP_RUSTLABS_BROWSER_PATH=
# Extra browser flags, e.g. "--no-sandbox --disable-dev-shm-usage" (needed in CI)
RPP_RUSTLABS_BROWSER_ARGS=
# Optional cookies for Cloudflare: full Cookie header, or just the cf_clearance value
RPP_RUSTLABS_COOKIE=
RPP_RUSTLABS_CF_CLEARANCE=
# Use the HTTP(S)_PROXY environment variables for the browser. Default: false
RPP_RUSTLABS_USE_PROXY=false

# --- Static data updater (scripts/updateStaticData.js) ---------------------
# Path to the Rust game "Bundles/items" folder. Leave empty for auto-detection.
RPP_RUST_ITEMS_DIR=
