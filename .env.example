# ---------------------------------------------------------------------------
#  rustplusplus - example environment configuration
#  Fork: https://github.com/HaxXorHardy/rustplusplus
#
#  Copy this file to ".env" and fill in your own values.
#  (".env" is git-ignored and loaded automatically on startup.)
# ---------------------------------------------------------------------------

# --- Discord Bot -----------------------------------------------------------
# Discord Application "General Information" -> Application ID
RPP_DISCORD_CLIENT_ID=
# Discord Application "Bot" -> Token
RPP_DISCORD_TOKEN=
# Display name of the bot (fallback only)
RPP_DISCORD_USERNAME=rustplusplus
# If true, only admins can delete servers/switches, manage credentials and reset channels
RPP_NEED_ADMIN_PRIVILEGES=true

# --- Battlemetrics ---------------------------------------------------------
# Optional Battlemetrics API token. Leave empty to disable the Battlemetrics tracker.
RPP_BATTLEMETRICS_TOKEN=

# --- General ---------------------------------------------------------------
# Language used for bot messages (see src/languages)
RPP_LANGUAGE=en
# Rust+ polling interval in milliseconds
RPP_POLLING_INTERVAL=10000
# Reconnect interval in milliseconds
RPP_RECONNECT_INTERVAL=15000

# --- Debug -----------------------------------------------------------------
# Debug mode: enables verbose (debug level) logging. Set to true for troubleshooting.
RPP_DEBUG=false
# Include call stack traces in error logs (debug mode forces this on anyway)
RPP_LOG_CALL_STACK=false

# --- RustLabs scraper (scripts/process_rustlabs.js) ------------------------
# Delay in milliseconds between page requests (politeness / anti-bot). Default: 2000
RPP_RUSTLABS_SLEEP_MS=2000
# Run the browser without a visible window. Default: false
# Note: Cloudflare may block headless requests; solve the challenge once in visible mode first.
RPP_RUSTLABS_HEADLESS=false
# After a Cloudflare challenge is solved in visible mode, continue headless. Default: true
RPP_RUSTLABS_HEADLESS_AFTER_CHALLENGE=true
# Request timeout in milliseconds. Default: 30000
RPP_RUSTLABS_TIMEOUT_MS=30000
# Max time (ms) to wait for a manually solved Cloudflare challenge. Default: 180000
RPP_RUSTLABS_CHALLENGE_WAIT_MS=180000
# Explicit browser executable (Edge/Chrome). Leave empty to auto-detect.
RPP_RUSTLABS_BROWSER_PATH=
# Optional cookies for Cloudflare: full Cookie header, or just the cf_clearance value
RPP_RUSTLABS_COOKIE=
RPP_RUSTLABS_CF_CLEARANCE=
# Use the HTTP(S)_PROXY environment variables for the browser. Default: false
RPP_RUSTLABS_USE_PROXY=false

# --- Static data updater (scripts/updateStaticData.js) ---------------------
# Path to the Rust game "Bundles/items" folder. Leave empty for auto-detection.
RPP_RUST_ITEMS_DIR=
