# ---------------------------------------------------------------------------
#  rustplusplus - example environment configuration
#  Fork: https://github.com/HaxXorHardy/rustplusplus
#
#  Copy this file to ".env" and fill in your own values.
#  (".env" is git-ignored and loaded automatically on startup.)
# ---------------------------------------------------------------------------

# --- Discord Bot -----------------------------------------------------------
# Discord Application "General Information" -> Application ID
RPP_DISCORD_CLIENT_ID=
# Discord Application "Bot" -> Token
RPP_DISCORD_TOKEN=
# Display name of the bot (fallback only)
RPP_DISCORD_USERNAME=rustplusplus
# If true, only admins can delete servers/switches, manage credentials and reset channels
RPP_NEED_ADMIN_PRIVILEGES=true

# --- Battlemetrics ---------------------------------------------------------
# Optional Battlemetrics API token. Leave empty to disable the Battlemetrics tracker.
RPP_BATTLEMETRICS_TOKEN=

# --- General ---------------------------------------------------------------
# Language used for bot messages (see src/languages)
RPP_LANGUAGE=en
# Rust+ polling interval in milliseconds
RPP_POLLING_INTERVAL=10000
# Reconnect interval in milliseconds
RPP_RECONNECT_INTERVAL=15000

# --- Debug -----------------------------------------------------------------
# Debug mode: enables verbose (debug level) logging. Set to true for troubleshooting.
RPP_DEBUG=false
# Include call stack traces in error logs (debug mode forces this on anyway)
RPP_LOG_CALL_STACK=false
